# ── Core ─────────────────────────────────────────────────────────
# Public URL of the app (used for OAuth redirects). Spotify requires 127.0.0.1 (not localhost) for local dev.
APP_URL=http://127.0.0.1:3000
# >= 32 random chars. Signs cookies and encrypts OAuth tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# SQLite file (Node >= 22.13 built-in node:sqlite). Defaults to ./data/sommelier.db
DATABASE_PATH=

# ── AI (optional, PAID per use) ──────────────────────────────────
# Without a key the deterministic TR/EN rule parser is used — the app stays fully functional.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_TIMEOUT_MS=25000
# Set to 0 to disable LLM curation beyond the local catalog
# SOMMELIER_LLM_CURATE=1

# ── Spotify (optional, needs Spotify Premium on the app owner's account) ──
# https://developer.spotify.com/dashboard → Redirect URI: ${APP_URL}/api/auth/spotify/callback
# Dev mode (2026): app owner needs Premium; max 5 users unless extended quota.
SPOTIFY_CLIENT_ID=
# Optional but recommended: enables public-mode catalog matching via Client Credentials.
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# ── Apple Music (optional, PAID: Apple Developer Program $99/yr) ──
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Contents of the MusicKit .p8 key, newlines as \n
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=tr

# ── YouTube Music (FREE: YouTube Data API v3, no billing needed) ─
# Google Cloud console → OAuth client (Web) → redirect: ${APP_URL}/api/auth/google/callback
# Enable "YouTube Data API v3". Default quota 10,000 units/day (search=100, insert=50).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
# Optional: availability checks without a connected account (counts against your project quota)
YOUTUBE_API_KEY=

# ── Feature enrichment ───────────────────────────────────────────
# ReccoBeats is keyless (needs Spotify client credentials to resolve IDs).
# RECCOBEATS_DISABLED=1
# Optional, FREE tempo/key fallback — https://getsongbpm.com/api (requires a backlink, shown on the Taste page)
GETSONGBPM_API_KEY=
# ENRICH_BUDGET_MS=6000

# ── AI mode ──────────────────────────────────────────────────────
# always = Claude reads every request/edit (default); auto = only rich/ambiguous ones
# SOMMELIER_LLM_MODE=always

# ── Deezer (FREE: public previews + BPM, no key) ─────────────────
# DEEZER_DISABLED=1
